# ---------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------

# Browser-side. The anon key is safe to ship — RLS is what protects data.
VITE_SUPABASE_URL=https://emuvmihfbnndhbpsndvc.supabase.co
VITE_SUPABASE_ANON_KEY=

# Domain used to synthesise Supabase Auth emails from ecodes.
# E1042 -> E1042@cyrix.local. Never receives mail; it is an internal id.
VITE_AUTH_EMAIL_DOMAIN=cyrix.local

# ---------------------------------------------------------------------
# Server-side only. NEVER prefix these with VITE_ — that would bundle
# them into the browser build and expose the whole database.
# ---------------------------------------------------------------------

# Supabase dashboard > Settings > Database > Connection string > URI
SUPABASE_DB_URL=

# Supabase dashboard > Settings > API > service_role key.
# Needed only by scripts/import-employees.mjs to create auth users.
SUPABASE_SERVICE_ROLE_KEY=
